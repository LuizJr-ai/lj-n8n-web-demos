# Purpose: safe placeholders for Demo 3 local configuration.
# Server-only Neon connection. Never prefix this variable with VITE_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Public n8n webhook called by the customer form.
VITE_DEMO3_WEBHOOK_URL=https://YOUR-N8N-HOST/webhook/demo3-aprovacao

# Server-only shared secret. Must equal the value of the Header Auth credential attached to the
# "Wait for approval" node (header name: X-Demo3-Resume). Never prefix this variable with VITE_.
RESUME_SECRET=YOUR_SHARED_SECRET
